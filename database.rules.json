{
  "rules": {
    ".read": false,
    ".write": false,
    "members": {
      "$key": {
        ".read": "auth != null && auth.token.email != null && auth.token.email.toLowerCase().replace('.', ',') === $key",
        ".write": false
      }
    },
    "as": {
      ".read": "auth != null && auth.token.email != null && root.child('members').child(auth.token.email.toLowerCase().replace('.', ',')).exists()",
      ".write": "auth != null && auth.token.email != null && root.child('members').child(auth.token.email.toLowerCase().replace('.', ',')).child('role').val() === 'edit'"
    },
    "presence": {
      ".read": "auth != null && auth.token.email != null && root.child('members').child(auth.token.email.toLowerCase().replace('.', ',')).exists()",
      "$key": {
        ".write": "auth != null && auth.token.email != null && auth.token.email.toLowerCase().replace('.', ',') === $key && root.child('members').child($key).exists()"
      }
    }
  }
}
